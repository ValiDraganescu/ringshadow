.DS_Store
art/raw/
art/gen.log
settings.local.json
__pycache__/
.env
# Review renders: made again on demand.
art/models/*/previews/
.idea/workspace.xml
# Unreal source assets. The models (~430 MB, exported once by the Swift game,
# which has left the repo) and the sounds and terrain prepared from
# unreal/Resources stay out of git. The hand-made and baked art is tracked.
unreal/Content-src/*
!unreal/Content-src/cursors/
!unreal/Content-src/fonts/
!unreal/Content-src/hud/
!unreal/Content-src/icons/
!unreal/Content-src/launcher/
# The Unreal remake: core-tests objects, and what Unreal makes.
unreal/core-tests/build/
unreal/server/build/
unreal/Binaries/
unreal/Intermediate/
unreal/Saved/
unreal/DerivedDataCache/
# What UAT's packaging writes into Build/Mac (K3): the cook's file order, the
# version counter, and copies of the engine's own Info.plist template and
# sandbox entitlements (identical to Engine/Build/Mac/Resources; the package
# needs none of them in git: build_release.sh sets the plist itself).
unreal/Build/Mac/FileOpenOrder/
unreal/Build/Mac/unreal.PackageVersionCounter
unreal/Build/Mac/Resources/Info.Template.plist
unreal/Build/Mac/Resources/Sandbox.NoNet.entitlements
unreal/Build/Mac/Resources/Sandbox.Server.entitlements
unreal/.vs/
unreal/*.xcworkspace

# The ringshadow-video skill's workspace: node_modules, tools, projects, clips, renders.
video/

# Orchestrator's own skills and agents (orc-*): local only, never published.
.claude/skills/orc-*/
.claude/agents/orc-*
# Local only: MCP socket paths, old screenshots, Claude Code locks.
.mcp.json
art/fog/
.claude/*.lock
# ElevenLabs raw generations (the sounds the game ships are under unreal/Resources/Sounds): a local cache, never committed.
Tools/AudioGen/raw/
# The editor auto-imports the loose cursor and splash images (which the game reads as files) into textures it never uses.
unreal/Content/UI/Cursors/*.uasset
unreal/Content/Splash/*.uasset
